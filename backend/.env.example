# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL - for Phase 2)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/apartment_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apartment_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Authentication (for Phase 2)
JWT_SECRET=your_jwt_secret_token_here_phase_2
JWT_EXPIRES_IN=1d
