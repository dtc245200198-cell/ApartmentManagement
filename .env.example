# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN (MẪU)
# Đề tài 36: Hệ thống quản lý căn hộ chung cư
# Không chứa mật khẩu thật hoặc secret key
# ==========================================

# Backend Settings
BACKEND_PORT=5000
NODE_ENV=development

# Database Settings (PostgreSQL - Chuẩn bị cho Giai đoạn 2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apartment_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/apartment_db

# JWT Secret (Bảo mật phiên đăng nhập)
JWT_SECRET=your_jwt_secret_token_here_phase_2
JWT_EXPIRES_IN=1d

# Frontend Settings
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api
