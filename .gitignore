# ==========================================
# Root .gitignore for Apartment Management System
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
*/dist/
build/
*/build/
dist-ssr/
*.local

# Environment variables & secrets (NEVER commit these)
.env
.env.*
*.env
*.env.*
.env.local
.env.*.local

# Preserve example environment templates
!.env.example
!*/.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & Editor generated files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Temporary files
tmp/
temp/
